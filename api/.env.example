# Supabase: Project Settings -> Database -> Connection string
# Pooled (transaction pooler, port 6543) for the running app
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct (port 5432) for migrations and pg-boss
DIRECT_URL="postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres"

PORT=3000
JWT_SECRET=change-me
# 32 bytes as 64 hex chars, used to encrypt merchant Paystack keys (AES-256-GCM)
ENCRYPTION_KEY=

# Groq (OpenAI-compatible)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo
# low = fewer tokens/min but less fluent Pidgin; medium is the better default
GROQ_REASONING_EFFORT=medium

# Which WhatsApp adapter to use: baileys | simulator
WHATSAPP_ADAPTER=simulator

# Nodemailer SMTP (e.g. Gmail app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Storage: r2 | local
STORAGE_DRIVER=local
STORAGE_DIR=./storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Public base URL for webhooks (cloudflared tunnel or deployed host)
PUBLIC_BASE_URL=http://localhost:3000

# Paystack requires an email per payment; we build <phone>@this-domain for WhatsApp customers
PAYMENT_EMAIL_DOMAIN=customers.shopbot.app

# paystack | fake (fake = no network, for local testing)
PAYMENT_DRIVER=fake

# Paystack real-payment test: set PAYMENT_DRIVER=paystack once the key is stored (npm run paystack:test forces it for you)
