// Multi-tenant: every business table carries merchantId.
// Money is stored in kobo (Int) to match Paystack and avoid float errors.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductCategory {
  CLOTHES
  SHOES
  JERSEY
  ACCESSORIES
}

enum ConversationMode {
  AI
  HUMAN
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSender {
  CUSTOMER
  AI
  OWNER
}

enum OrderStatus {
  DRAFT
  AWAITING_PAYMENT
  PAID
  FULFILLED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum NegotiationStatus {
  OPEN
  AGREED
  DECLINED
}

enum SessionStatus {
  DISCONNECTED
  QR_PENDING
  CONNECTED
}

model Merchant {
  id                  String   @id @default(uuid())
  businessName        String
  ownerName           String
  ownerPhone          String // WhatsApp number that receives handoff alerts, digits only e.g. 2348012345678
  ownerEmail          String   @unique // login identity
  alertEmail          String? // where owner alerts are emailed; falls back to ownerEmail
  passwordHash        String
  maxDiscountPercent  Int      @default(0) // merchant-wide cap, applied on top of per-variant minPrice
  aiEnabled           Boolean  @default(true)
  paystackSecretEnc   String? // AES-GCM encrypted, never logged
  receiptCounter      Int      @default(0)
  orderCounter        Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  session       WhatsAppSession?
  authItems     WaAuthItem[]
  products      Product[]
  customers     Customer[]
  conversations Conversation[]
  orders        Order[]
}

model WhatsAppSession {
  merchantId String        @id
  status     SessionStatus @default(DISCONNECTED)
  phone      String?
  qr         String? // latest QR string while QR_PENDING
  updatedAt  DateTime      @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

// Baileys auth state (creds + signal keys) lives here so any host can restart without a new QR.
model WaAuthItem {
  merchantId String
  key        String
  value      String // JSON serialised with Baileys BufferJSON

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@id([merchantId, key])
}

model Product {
  id          String          @id @default(uuid())
  merchantId  String
  name        String
  description String?
  category    ProductCategory
  attributes  Json            @default("{}") // e.g. jersey: {club, season, version}; shoes: {brand}
  imageKeys   String[] // storage keys, resolved to URLs by StoragePort
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())

  merchant Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  variants Variant[]

  @@index([merchantId, category])
}

model Variant {
  id           String   @id @default(uuid())
  productId    String
  merchantId   String
  sku          String?
  size         String? // "42", "M", "XL"
  color        String?
  priceKobo    Int
  minPriceKobo Int // lowest price the owner accepts. NEVER sent to the LLM.
  stock        Int      @default(0) // physical units
  reserved     Int      @default(0) // held for unpaid orders. available = stock - reserved
  createdAt    DateTime @default(now())

  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  negotiations Negotiation[]

  @@index([merchantId, productId])
}

model Customer {
  id         String   @id @default(uuid())
  merchantId String
  phone      String // WhatsApp id digits
  name       String?
  address    String?
  createdAt  DateTime @default(now())

  merchant      Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  orders        Order[]

  @@unique([merchantId, phone])
}

model Conversation {
  id             String           @id @default(uuid())
  merchantId     String
  customerId     String
  chatId         String // gateway chat id
  mode           ConversationMode @default(AI)
  handoffReason  String?
  humanSince     DateTime?
  lastMessageAt  DateTime         @default(now())
  createdAt      DateTime         @default(now())

  merchant     Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages     Message[]
  orders       Order[]
  negotiations Negotiation[]

  @@unique([merchantId, chatId])
}

model Message {
  id             String           @id @default(uuid())
  merchantId     String
  conversationId String
  externalId     String? // WhatsApp message id, used for dedupe
  direction      MessageDirection
  sender         MessageSender
  type           String // text | audio | image | document
  text           String?
  meta           Json? // AI messages: { shown: ["Name size=ref", ...] } so the model can resolve "that one" next turn
  createdAt      DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([merchantId, externalId])
  @@index([conversationId, createdAt])
}

model Negotiation {
  id             String            @id @default(uuid())
  conversationId String
  variantId      String
  rounds         Int               @default(0)
  lastOfferKobo  Int?
  quotedKobo     Int? // the last price WE quoted (counter / final). accept_price turns it into agreedKobo
  agreedKobo     Int?
  status         NegotiationStatus @default(OPEN)
  updatedAt      DateTime          @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  variant      Variant      @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([conversationId, variantId])
}

model Order {
  id               String      @id @default(uuid())
  merchantId       String
  customerId       String
  conversationId   String
  orderNumber      String // human readable per merchant, e.g. ORD-000123
  status           OrderStatus @default(DRAFT)
  subtotalKobo     Int         @default(0)
  deliveryFeeKobo  Int         @default(0)
  totalKobo        Int         @default(0)
  deliveryAddress  String?
  expiresAt        DateTime? // reservation expiry while AWAITING_PAYMENT
  paidAt           DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  merchant     Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])
  items        OrderItem[]
  payment      Payment?
  receipt      Receipt?

  @@unique([merchantId, orderNumber])
  @@index([merchantId, status])
}

model OrderItem {
  id            String @id @default(uuid())
  orderId       String
  variantId     String
  quantity      Int
  listPriceKobo Int
  unitPriceKobo Int // agreed price after negotiation (never below the variant floor)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id])
}

model Payment {
  id          String        @id @default(uuid())
  orderId     String        @unique
  reference   String        @unique // Paystack reference
  status      PaymentStatus @default(PENDING)
  amountKobo  Int
  checkoutUrl String?
  rawEvent    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Receipt {
  id        String   @id @default(uuid())
  orderId   String   @unique
  number    String // RCP-000123, per merchant
  fileKey   String
  sentAt    DateTime? // set atomically when the receipt is delivered, so it is never sent twice
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// Idempotency for webhooks and inbound messages.
model ProcessedEvent {
  id        String   @id // e.g. "paystack:charge.success:<reference>"
  createdAt DateTime @default(now())
}
